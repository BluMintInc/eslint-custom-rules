# Typescript v1 declaration files
typings/

# Dependencies
# Slashless: a trailing slash matches directories only, so a `node_modules`
# symlink stays trackable and `git add -A` commits it.
node_modules

# IDE
.vscode

# Logs
**/*.log
.nyc_output
.nyc_output/**/*
*.DS_Store
reports/jest-*.xml

# Coverage output
coverage
coverage/**/*
*.xml

# Built files
lib/
lib/**/*
lib/package.json
**/*.js
**/*.js.map
*.tsbuildinfo

.env
.env*
.flaskenv*
!.env.project
!.env.vault

# But don't ignore scripts
!scripts/**/*.js

# Ignored in this eslint-custom-rules repo so that it only shows in the agora repo
.specstory/

# Cursor hooks temporary files
.cursor/tmp/
.cursor/.agent-tools/
core
tmp/

# Ignore interactive question-prompt rule not shipped with the plugin
.cursor/rules/do-not-hesitate-to-ask-questions.mdc

# Per-machine Claude Code settings (a BLUMINT_GOVERNOR_CLI path, local permissions);
# the maintainer stages with `git add -A`, so an untracked copy would be committed
.claude/settings.local.json
.claude/worktrees/

# The shim harness sits in a directory named `lib`, which the built-files rule
# above ignores unanchored. Without this negation the three `.test.mjs` shim
# suites ship without the module they import.
!.claude/hooks/lib/
